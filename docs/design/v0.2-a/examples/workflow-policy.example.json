{
  "schema_version": 1,
  "profile": "dual-review",
  "mode": "B",
  "authorization_required": true,
  "agents": {
    "implementer": {
      "adapter": "codex-cli",
      "session_policy": "resume-bound",
      "model_policy": "approved-local-binding"
    },
    "reviewer": {
      "adapter": "claude-cli",
      "session_policy": "resume-bound",
      "model_policy": "approved-local-binding"
    }
  },
  "limits": {
    "max_review_rounds": 5,
    "max_infrastructure_retries": 2,
    "step_timeout_seconds": 1800,
    "max_log_bytes": 16777216
  },
  "delivery": {
    "commit": false,
    "push": false,
    "merge": false,
    "force": false,
    "tag": false,
    "release": false
  },
  "required_contracts": [
    "example.unit"
  ],
  "verification": [
    {
      "id": "example.unit",
      "argv": [
        "python3",
        "-m",
        "pytest",
        "tests",
        "--junitxml",
        "{result}",
        "-q"
      ],
      "result_format": "junit",
      "min_cases": 1,
      "max_skipped": 0
    }
  ]
}
